{
  "name": "putuj-sam",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "package:namecheap": "npm run build && npm run test:seo && node scripts/package-namecheap.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "test:production": "PLAYWRIGHT_PRODUCTION=1 playwright test",
    "test:seo": "node --test tests/seo.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.51.0",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "typescript": "~5.7.2",
    "vite": "^6.4.1"
  }
}
